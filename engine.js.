let audioCtx = null;

function playClick() {
    try {
        if(!audioCtx) { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
        if (audioCtx.state === 'suspended') { audioCtx.resume(); }
        const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
        osc.type = "triangle"; osc.frequency.setValueAtTime(650, audioCtx.currentTime); 
        osc.frequency.exponentialRampToValueAtTime(150, audioCtx.currentTime + 0.04);
        gain.gain.setValueAtTime(0.06, audioCtx.currentTime); gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.04);
        osc.connect(gain); gain.connect(audioCtx.destination); osc.start(); osc.stop(audioCtx.currentTime + 0.04);
    } catch(e){}
}

function playSuccessSound() {
    try {
        if(!audioCtx) return;
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
        osc.type = "sine"; 
        osc.frequency.setValueAtTime(880, now); 
        osc.frequency.linearRampToValueAtTime(1760, now + 0.12);
        gain.gain.setValueAtTime(0.04, now); 
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12); 
        osc.connect(gain); gain.connect(audioCtx.destination); 
        osc.start(now); osc.stop(now + 0.12);
    } catch(e){}
}

let titleTapCount = 0;
let titleTapTimer = null;
function handleTitleTap() {
    titleTapCount++;
    if (titleTapCount === 3) {
        const historyPanel = document.getElementById('secretHistoryPanel');
        historyPanel.classList.toggle('hidden');
        titleTapCount = 0; 
    }
    clearTimeout(titleTapTimer);
    titleTapTimer = setTimeout(() => { titleTapCount = 0; }, 1000);
}

function toggleDir(type) {
    currentMode = type;
    ['global', 'india', 'bd', 'eu'].forEach(d => {
        document.getElementById(`dir-${d}`).className = d === type ? "flex-1 bg-emerald-600 text-white text-[9px] font-black tracking-wider py-2 rounded-lg cursor-pointer uppercase shadow-md shadow-emerald-500/20" : "flex-1 bg-transparent text-gray-500 text-[9px] font-black tracking-wider py-2 rounded-lg cursor-pointer hover:text-gray-300 uppercase";
    });
    evaluateMonthSelectState();
}

function selectCategory(category, element) {
    currentSelectedCategory = category;
    document.querySelectorAll('.category-btn').forEach(btn => btn.className = "category-btn bg-black/50 text-gray-500 px-3.5 py-2.5 rounded-lg whitespace-nowrap cursor-pointer transition-all");
    element.className = "category-btn bg-emerald-950/40 text-emerald-400 border border-emerald-500/30 px-3.5 py-2.5 rounded-lg whitespace-nowrap cursor-pointer transition-all";
    evaluateMonthSelectState();
}

function evaluateMonthSelectState() {
    const monthDropdown = document.getElementById('monthCodeInput');
    if ((currentSelectedCategory === 'TOPUP' || currentSelectedCategory === 'FE' || currentMode === 'bd') && currentSelectedCategory !== 'STORE') { 
        monthDropdown.disabled = true; 
    } else { 
        monthDropdown.disabled = false; 
    }
}

function getActiveKeywords(selectedMonth) {
    let list = [];
    if (currentSelectedCategory === 'all' || currentSelectedCategory === 'TOPUP') list.push("TopUp");
    if (currentSelectedCategory === 'all' || currentSelectedCategory === 'FE') list.push("FreeEvent");
    
    if (currentSelectedCategory === 'all' || currentSelectedCategory === 'O') { 
        if (currentMode === 'eu') {
            for(let i=1; i<=7; i++) {
                list.push(`O${i}`);
                list.push(`OT${i}`);
            }
        } else if (selectedMonth === "AUG" || selectedMonth === "JUL" || selectedMonth === "JUN") { 
            for(let i=1; i<=7; i++) list.push(`OT${i}`); 
        } else { 
            for(let i=1; i<=7; i++) list.push(`O${i}`); 
        } 
    }
    
    if (currentSelectedCategory === 'all' || currentSelectedCategory === 'TW') for(let i=1; i<=7; i++) list.push(`TW${i}`);
    if (currentSelectedCategory === 'all' || currentSelectedCategory === 'TT') for(let i=1; i<=7; i++) list.push(`TT${i}`);
    if (currentSelectedCategory === 'all' || currentSelectedCategory === 'FW') for(let i=1; i<=7; i++) list.push(`FW${i}`);
    if (currentSelectedCategory === 'all' || currentSelectedCategory === 'DW') for(let i=1; i<=7; i++) list.push(`DW${i}`);
    if (currentSelectedCategory === 'all' || currentSelectedCategory === 'SPLASH') list.push("SPLASH", "BANNER", "EVO");
    if (currentSelectedCategory === 'all' || currentSelectedCategory === 'RM') list.push("RelayMart");
    return list;
}

function getActiveSuffixes(keyword) { 
    if (currentMode === 'eu') { 
        return [
            { suffix: "_Tab_EU_en.jpg", label: "TAB (EU)" },
            { suffix: "_Poster_EU_en.png", label: "POSTER (EU)" },
            { suffix: "_Title_EU_en.png", label: "TITLE (EU)" },
            { suffix: "_LobbyBG_EU_en.jpg", label: "LOBBY BG (EU)" },
            { suffix: "_WheelBG_EU_en.png", label: "WHEEL BG (EU)" },
            { suffix: "_en.png", label: "ASSET (PNG)" }
        ]; 
    }
    
    let formats = [
        { suffix: "_Tab_SG_en.jpg", label: "TAB (SG)" },
        { suffix: "_Poster_SG_en.png", label: "POSTER (PNG)" },
        { suffix: "_Title_SG_en.png", label: "TITLE PNG" }
    ];
    if (keyword.startsWith("TW") || keyword.startsWith("TT") || keyword.startsWith("FW") || keyword.startsWith("O") || keyword.startsWith("MS") || keyword.startsWith("OT")) {
        formats.push({ suffix: "_LobbyBG_SG_en.jpg", label: "LOBBY BG" });
        formats.push({ suffix: "_WheelBG_SG_en.png", label: "WHEEL BG" });
    }
    return formats;
}

function saveSearchLog(keyword, foundCount) {
    let history = JSON.parse(localStorage.getItem('ff_assets_finder_logs') || "[]");
    const newLog = {
        keyword: keyword,
        server: currentMode.toUpperCase(),
        category: currentSelectedCategory.toUpperCase(),
        found: foundCount,
        time: new Date().toLocaleTimeString()
    };
    history.unshift(newLog);
    if(history.length > 30) history.pop();
    localStorage.setItem('ff_assets_finder_logs', JSON.stringify(history));
    renderHistoryLogs();
}

function renderHistoryLogs() {
    const container = document.getElementById('historyLogsContainer');
    let history = JSON.parse(localStorage.getItem('ff_assets_finder_logs') || "[]");
    if(history.length === 0) {
        container.innerHTML = `<div class="text-gray-600 text-center py-2">No scans executed yet.</div>`;
        return;
    }
    container.innerHTML = history.map(log => {
        const statusColor = log.found > 0 ? 'text-emerald-400' : 'text-red-500';
        return `<div class="flex items-center justify-between border-b border-emerald-950/40 pb-1.5 pt-0.5">
            <div class="flex items-center gap-1.5 truncate">
                <span class="text-emerald-500 font-bold">[${log.server}]</span>
                <span class="text-white font-medium truncate" title="${log.keyword}">${log.keyword}</span>
            </div>
            <div class="flex items-center gap-2 shrink-0">
                <span class="text-gray-500">${log.time}</span>
                <span class="font-black ${statusColor}">(${log.found} FOUND)</span>
            </div>
        </div>`;
    }).join('');
}

function clearSearchHistory() {
    localStorage.setItem('ff_assets_finder_logs', '[]');
    renderHistoryLogs();
}

function openImagePreview(url, name) {
    document.getElementById('lightboxImage').src = url; 
    document.getElementById('lightboxTitle').innerText = name; 
    document.getElementById('lightboxDownloadBtn').href = url;
    document.getElementById('lightboxCopyBtn').setAttribute('data-url', url);
    document.getElementById('lightboxCopyBtn').innerText = "COPY URL";
    document.getElementById('imageLightbox').classList.remove('hidden'); 
    document.body.style.overflow = 'hidden';
}

function closeImagePreview() { 
    document.getElementById('imageLightbox').classList.add('hidden'); 
    document.body.style.overflow = ''; 
}

function copyToClipboard(text, btnElement) {
    navigator.clipboard.writeText(text).then(() => {
        const oldText = btnElement.innerText;
        btnElement.innerText = "COPIED!";
        setTimeout(() => { btnElement.innerText = oldText; }, 1200);
    }).catch(err => {
        alert("Failed to copy link.");
    });
}

async function startManualHyperScan(isHyperMode = false) {
    forceBreakScanner = false; 
    let inputFieldVal = document.getElementById('searchInput').value.trim();
    if (!inputFieldVal) return alert("Please enter the Event Keyword");
    
    let cleanSpaces = inputFieldVal.replace(/\s+/g, '');
    let cleanBaseWord = cleanSpaces.replace(/^(TW|TT|FW|OT|O|DW|MS|TopUp|FreeEvent)\d?_?/i, '');
    cleanBaseWord = cleanBaseWord.replace(/(Ring|Tower|Wheel|Faded|MysteryShop|Shop)$/i, '');
    
    let rawVariants = [
        cleanSpaces,
        cleanBaseWord, 
        cleanBaseWord.toLowerCase(), 
        cleanBaseWord.toUpperCase(), 
        cleanBaseWord.charAt(0).toUpperCase() + cleanBaseWord.slice(1)
    ];

    let low = cleanBaseWord.toLowerCase();
    if (low.includes("kickoff") || low.includes("ring") || low.includes("winning") || low.includes("kick")) {
        let baseCleaned = cleanBaseWord.replace(/kickoff/i, 'Kickoff').replace(/ring/i, 'Ring').replace(/winning/i, 'Winning').replace(/kick/i, 'Kick');
        rawVariants.push(baseCleaned, baseCleaned.charAt(0).toUpperCase() + baseCleaned.slice(1));
    }
    let variants = [...new Set(rawVariants)];
    
    const statusArea = document.getElementById('statusArea');
    const resultsContainer = document.getElementById('resultsContainer');
    
    statusArea.classList.remove('hidden'); 
    resultsContainer.innerHTML = `<div class="pt-1"><h3 class="text-[10px] font-black text-emerald-400 mb-2.5 uppercase tracking-wider">📡 INJECTED DATA BLOCK (${currentMode.toUpperCase()})</h3><div id="sg-grid" class="grid grid-cols-2 gap-2.5"></div></div>`;
    const sgGrid = document.getElementById('sg-grid');
    
    let allUrlsToTest = [];
    const yearPrefix = "26"; 

    let targetMonths = [];
    if (isHyperMode) {
        targetMonths = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
    } else {
        targetMonths.push(document.getElementById('monthCodeInput').value);
    }

    let foundLabelsTracker = new Set();
    let maxUniqueSuffixFormatsPossible = (currentMode === 'eu') ? 7 : 5;

    variants.forEach(finalSearchWord => {
        if (currentMode === 'bd') {
            if (currentSelectedCategory === 'all' || currentSelectedCategory === 'SPLASH' || currentSelectedCategory === 'TOPUP' || currentSelectedCategory === 'TW' || currentSelectedCategory === 'TT' || currentSelectedCategory === 'FW' || currentSelectedCategory === 'O' || currentSelectedCategory === 'DW' || currentSelectedCategory === 'MS' || currentSelectedCategory === 'FE' || currentSelectedCategory === 'STORE' || currentSelectedCategory === 'MYSTERY') {
                allUrlsToTest.push({ url: `${URL_MAP.bd}config/17501070_${finalSearchWord}BD_en.jpg`, name: `${finalSearchWord}BD_en.jpg`, tag: "BD TAB" });
            }
            if (currentSelectedCategory === 'all' || currentSelectedCategory === 'SPLASH') {
                allUrlsToTest.push({ url: `${URL_MAP.bd_splash}1750x1070_${finalSearchWord}_en.jpg`, name: `BD_Splash_${finalSearchWord}.jpg`, tag: "BD SPLASH" });
            }
        } else {
            if (currentSelectedCategory === 'all' || currentSelectedCategory === 'MS') {
                targetMonths.forEach(currentMonthChar => {
                    for (let d = 31; d >= 1; d--) {
                        const loopPrefix = yearPrefix + currentMonthChar + d;
                        const msSuffixes = [
                            { sfx: "_Tab_SG_en.jpg", tag: "MS TAB" },
                            { sfx: "_Poster_SG_en.png", tag: "MS POSTER" },
                            { sfx: "_Title_SG_en.png", tag: "MS TITLE" },
                            { sfx: "_LobbyBG_SG_en.jpg", tag: "MS LOBBY BG" },
                            { sfx: "_WheelBG_SG_en.png", tag: "MS WHEEL BG" }
                        ];

                        msSuffixes.forEach(item => {
                            allUrlsToTest.push({
                                url: `https://dl.dir.freefiremobile.com/common/Local/IND/config/${loopPrefix}_MocoStore_${finalSearchWord}${item.sfx}`,
                                name: `${loopPrefix}_MocoStore_${finalSearchWord}${item.sfx}`,
                                tag: item.tag
                            });
                        });
                    }
                });
            }

            if (currentSelectedCategory === 'all' || currentSelectedCategory === 'MYSTERY') {
                targetMonths.forEach(currentMonthChar => {
                    for (let d = 31; d >= 1; d--) {
                        const loopPrefix = yearPrefix + currentMonthChar + d;
                        const msSuffixes = [
                            { sfx: "_ShopIDMysteryShop_SG.jpg", tag: "MS SHOP ID" },
                            { sfx: "_BackgroundMysteryShop_SG.jpg", tag: "MS BACKBG" },
                            { sfx: "_CenterBG_SG.png", tag: "MS CENTER BG" },
                            { sfx: "_Bundle1MysteryShopA_SG.png", tag: "MS BUNDLE 1A" },
                            { sfx: "_Bundle1MysteryShopB_SG.png", tag: "MS BUNDLE 1B" },
                            { sfx: "_Bundle2MysteryShopA_SG.png", tag: "MS BUNDLE 2A" },
                            { sfx: "_Bundle2MysteryShopB_SG.png", tag: "MS BUNDLE 2B" },
                            { sfx: "_Bundle1V2MysteryShop_SG.jpg", tag: "MS BUNDLE 1V2" },
                            { sfx: "_Bundle2V2MysteryShop_SG.jpg", tag: "MS BUNDLE 2V2" }
                        ];

                        msSuffixes.forEach(item => {
                            allUrlsToTest.push({
                                url: `${URL_MAP[currentMode]}${loopPrefix}_MS_${finalSearchWord}${item.sfx}`,
                                name: `${loopPrefix}_MS_${finalSearchWord}${item.sfx}`,
                                tag: item.tag
                            });
                        });
                    }
                });
            }

            if (currentSelectedCategory === 'all' || currentSelectedCategory === 'STORE') {
                targetMonths.forEach(currentMonthChar => {
                    for (let d = 31; d >= 1; d--) {
                        const loopPrefix = yearPrefix + currentMonthChar + d;
                        
                        allUrlsToTest.push({
                            url: `${URL_MAP[currentMode]}1500x750_${finalSearchWord}_${loopPrefix}_en.jpg`,
                            name: `1500x750_${finalSearchWord}_${loopPrefix}_en.jpg`,
                            tag: "STORE 1500"
                        });
                        allUrlsToTest.push({
                            url: `${URL_MAP[currentMode]}252x256_${finalSearchWord}_${loopPrefix}_en.jpg`,
                            name: `252x256_${finalSearchWord}_${loopPrefix}_en.jpg`,
                            tag: "STORE 252"
                        });
                    }
                });
            }

            if (currentSelectedCategory === 'all' || currentSelectedCategory === 'TOPUP') {
                let suffixes = (currentMode === 'eu') ? ["TopUp_EU_en.jpg", "TopUp_en.png", "TopUpEU_SmallBanner_en.jpg"] : ["TopUp_en.png", "TopUpSG_en.png", "TopUpNA_en.png", "_Tab_SG_en.jpg", "_Tab_PK_en.jpg", "_Tab_NA_en.jpg"];
                suffixes.forEach(sfx => { 
                    let finalUrl = sfx.startsWith("GoalTopUp") ? (URL_MAP['eu'] + sfx) : (URL_MAP[currentMode] + finalSearchWord + sfx);
                    allUrlsToTest.push({ url: finalUrl, name: finalSearchWord + sfx, tag: "TOPUP DIRECT" }); 
                });
            }

            if (currentSelectedCategory === 'all' || currentSelectedCategory === 'FE') {
                let feSuffixes = ["_1400x700_en.jpg", "SG_1400x700_en.jpg"];
                feSuffixes.forEach(sfx => {
                    allUrlsToTest.push({ 
                        url: `${URL_MAP[currentMode]}${finalSearchWord}${sfx}`, 
                        name: `${finalSearchWord}${sfx}`, 
                        tag: "FREE EVENT" 
                    });
                });
            }

            if (currentSelectedCategory !== 'TOPUP' && currentSelectedCategory !== 'FE' && currentSelectedCategory !== 'STORE' && currentSelectedCategory !== 'MYSTERY' && currentSelectedCategory !== 'MS') {
                targetMonths.forEach(currentMonthChar => {
                    let activeKeywords = getActiveKeywords(currentMonthChar);
                    for (let d = 31; d >= 1; d--) {
                        const loopPrefix = yearPrefix + currentMonthChar + d;

                        activeKeywords.forEach(keyword => { 
                            if(keyword === "TopUp" || keyword === "FreeEvent") return; 
                            if (keyword === "RelayMart") {
                                allUrlsToTest.push({ url: `${URL_MAP[currentMode]}${keyword}${finalSearchWord}-256x107IND_en.png`, name: `${keyword}${finalSearchWord}-256x107IND`, tag: "RM BANNER" });
                                allUrlsToTest.push({ url: `${URL_MAP[currentMode]}1500x750_${keyword}${finalSearchWord}_${loopPrefix}_en.jpg`, name: `1500x750_${keyword}${finalSearchWord}`, tag: "RM 1500x750" });
                                allUrlsToTest.push({ url: `${URL_MAP[currentMode]}252x256_${keyword}${finalSearchWord}_${loopPrefix}_en.jpg`, name: `252x256_${keyword}${finalSearchWord}`, tag: "RM 252x256" });
                                return; 
                            }
                            
                            let totalSuffixes = getActiveSuffixes(keyword);
                            totalSuffixes.forEach(asset => { 
                                let generatedUrl = "";
                                let generatedName = "";
                                if (currentMode === 'eu') {
                                    generatedUrl = `${URL_MAP[currentMode]}${loopPrefix}_${keyword}${finalSearchWord}${asset.suffix}`;
                                    generatedName = `${loopPrefix}_${keyword}${finalSearchWord}${asset.suffix}`;
                                } else {
                                    generatedUrl = `${URL_MAP[currentMode]}${loopPrefix}_${keyword}_${finalSearchWord}${asset.suffix}`;
                                    generatedName = `${loopPrefix}_${keyword}_${finalSearchWord}${asset.suffix}`;
                                }
                                allUrlsToTest.push({ url: generatedUrl, name: generatedName, tag: asset.label }); 
                            }); 
                        });
                    }
                });
            }
        }
    });

    let uniqueUrls = []; let urlCheckSet = new Set();
    allUrlsToTest.forEach(item => { if(!urlCheckSet.has(item.url)) { urlCheckSet.add(item.url); uniqueUrls.push(item); } });
    const totalRequests = uniqueUrls.length; if (totalRequests === 0) { statusArea.classList.add('hidden'); return; }
    
    let processedCount = 0, foundAssets = 0, index = 0;
    const CONCURRENCY_LIMIT = isHyperMode ? 1350 : 750; 

    async function worker() {
        while (index < totalRequests) {
            if (forceBreakScanner) break; 
            
            const item = uniqueUrls[index++]; if (!item) break;
            const exists = await new Promise((res) => { const img = new Image(); img.onload = () => res(true); img.onerror = () => res(false); img.src = item.url; });
            
            if (exists) { 
                foundAssets++; 
                playSuccessSound(); 
                injectCard(sgGrid, item.url, item.name, item.tag); 
                document.getElementById('extractCount').innerText = `UNLOCKED: ${foundAssets}`; 
                
                foundLabelsTracker.add(item.tag);
                
                if (foundLabelsTracker.size >= maxUniqueSuffixFormatsPossible && currentSelectedCategory !== 'all' && currentSelectedCategory !== 'FE' && currentSelectedCategory !== 'STORE' && currentSelectedCategory !== 'MYSTERY' && currentSelectedCategory !== 'MS') {
                    forceBreakScanner = true; 
                    document.getElementById('statusText').innerText = `⚡ Auto-Stopped: All ${foundAssets} Image Assets Discovered!`;
                    document.getElementById('pFill').style.width = '100%'; 
                    document.getElementById('percentText').innerText = '100%';
                    break;
                }
            }
            processedCount++;
            if (processedCount % 30 === 0 || processedCount === totalRequests) {
                if (!forceBreakScanner) {
                    let pct = Math.round((processedCount / totalRequests) * 100);
                    document.getElementById('pFill').style.width = pct + '%'; document.getElementById('percentText').innerText = pct + '%'; 
                    document.getElementById('statusText').innerText = isHyperMode ? `⚡ HYPER SPEED SCAN: ${processedCount}/${totalRequests}...` : `Searching: ${processedCount}/${totalRequests}...`;
                }
            }
        }
    }
    const workers = []; for (let w = 0; w < Math.min(CONCURRENCY_LIMIT, totalRequests); w++) workers.push(worker());
    await Promise.all(workers);
    
    if (!forceBreakScanner) {
        document.getElementById('statusText').innerText = foundAssets > 0 ? `Scan Complete! Discovered ${foundAssets} Assets.` : "No Assets Detected.";
    }

    saveSearchLog(inputFieldVal, foundAssets);
}

